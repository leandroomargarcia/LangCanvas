# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Firebase Admin (server) — from Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langcanvas
# Optional salt for anonymizing visitor IPs in traces
IP_HASH_SALT=

# Feedback email via Resend (https://resend.com) — required for the Feedback button
RESEND_API_KEY=
FEEDBACK_TO=leandroomargarcia@gmail.com
# Use a verified domain sender in production, e.g. LangCanvas <feedback@yourdomain.com>
# For Resend test mode, onboarding@resend.dev can only send to your Resend account email.
RESEND_FROM=LangCanvas <onboarding@resend.dev>

# Generate code uses public LangChain MCP (no key):
# https://docs.langchain.com/mcp
# https://reference.langchain.com/mcp
